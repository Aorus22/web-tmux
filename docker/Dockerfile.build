# syntax=docker/dockerfile:1

# Tmux GUI — AppImage BUILD environment (Linux x86_64).
#
# This image carries the toolchain + system headers ONLY; the source tree is
# never copied in. Callers mount the repo at /src and run the repo's own build
# script, so the same image serves CI and a local one-off:
#
#   docker build -f docker/Dockerfile.build -t webtmux-build .
#   docker run --rm -v "$PWD:/src" -w /src webtmux-build \
#     bash docker/build-appimage.sh
#
# Result: dist/Tmux-GUI-<version>-x86_64.AppImage in the host tree.
# GitHub Actions does exactly this (.github/workflows/build-appimage.yml).
#
# Base is Debian bookworm on purpose: its glibc (2.36) is OLDER than the target
# desktops' (Fedora/Ubuntu), which is the safe direction for a portable
# AppImage — the binary only needs symbols that already existed at build time.

# Sidecars: pinned by tag, and only their binaries are copied into the builder.
FROM golang:1.27-bookworm AS go-src
FROM node:24-bookworm-slim AS node-src

FROM rust:1.98-slim-bookworm AS build

ARG DEBIAN_FRONTEND=noninteractive
ARG APPIMAGETOOL_URL=https://github.com/AppImage/appimagetool/releases/download/continuous/appimagetool-x86_64.AppImage

# System build deps, in three groups:
#   1. toolchain plumbing — pkg-config drives every `-sys` crate.
#   2. clang/libclang — `gpui-pre` and `gpui-pre-media` run bindgen at build
#      time, which loads libclang.
#   3. window/GL/font stack — the GTK3 dev headers (the client's desktop-theme
#      probe uses the `gtk` crate), fontconfig + freetype for text, and the
#      X11/Wayland/Vulkan headers gpui links against.
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config ca-certificates curl file \
      clang libclang-dev \
      libfontconfig1-dev libfreetype-dev \
      libx11-dev libxcb1-dev libxkbcommon-dev libxkbcommon-x11-dev \
      libwayland-dev libvulkan-dev \
      libgtk-3-dev \
 && rm -rf /var/lib/apt/lists/*

# Go toolchain — builds the `tmux-gui-server` sidecar the AppImage ships.
COPY --from=go-src /usr/local/go /usr/local/go
ENV PATH="/usr/local/go/bin:${PATH}"

# Node + npm — builds the vite bundle that the Go server `go:embed`s.
COPY --from=node-src /usr/local/bin/node /usr/local/bin/node
COPY --from=node-src /usr/local/lib/node_modules /usr/local/lib/node_modules
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
 && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
 && node --version && npm --version && go version && cargo --version

# appimagetool: extracted (containers have no FUSE) and exposed through the
# APPIMAGETOOL env var that desktop-gpui/scripts/package-appimage.sh already
# honours. The bundle ships its own static mksquashfs + desktop-file-validate,
# so no extra apt package is needed.
RUN curl -fsSL -o /tmp/appimagetool "$APPIMAGETOOL_URL" \
 && chmod +x /tmp/appimagetool \
 && cd /tmp \
 && /tmp/appimagetool --appimage-extract > /dev/null \
 && mv /tmp/squashfs-root /opt/appimagetool \
 && rm -f /tmp/appimagetool
ENV APPIMAGETOOL=/opt/appimagetool/AppRun

WORKDIR /src
