# syntax=docker/dockerfile:1

# Tmux GUI — TEST environment (Rust workspace: unit + integration tests).
#
# Same system-header set as docker/Dockerfile.build (the workspace links gpui
# and the GTK theme probe, so compiling the tests needs the exact same libs),
# minus the packaging extras (Go, Node, appimagetool) that tests do not touch.
#
#   docker build -f docker/Dockerfile.test -t webtmux-test .
#   docker run --rm -v "$PWD:/src" -w /src webtmux-test \
#     cargo test --workspace
#
# GitHub Actions: .github/workflows/test.yml

FROM rust:1.98-slim-bookworm

ARG DEBIAN_FRONTEND=noninteractive

RUN apt-get update \
 && apt-get install -y --no-install-recommends \
      build-essential pkg-config ca-certificates \
      clang libclang-dev \
      libfontconfig1-dev libfreetype-dev \
      libx11-dev libxcb1-dev libxkbcommon-dev libxkbcommon-x11-dev \
      libwayland-dev libvulkan-dev \
      libgtk-3-dev \
 && rm -rf /var/lib/apt/lists/*

WORKDIR /src
